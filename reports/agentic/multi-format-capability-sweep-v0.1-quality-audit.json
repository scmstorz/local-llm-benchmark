  "findings": [
    {
      "finding_id": "F-01",
      "position": 1,
      "classification": "contradictory_west_approval",
      "observation": "The executive prose says that North and West pass all four gates and a launch rationale calls North one of two passing regions, while the same report also states that West is at 94% against a 95% threshold. West must be held, so the prose is internally contradictory and unsafe for the steering decision.",
      "source_fact_codes": ["POL-GATES", "REL-WEST"]
    },
    {
      "finding_id": "F-02",
      "position": 4,
      "classification": "contradictory_west_approval",
      "observation": "The executive prose approves both North and West even though West's final completion is 94% and the policy requires at least 95%. A later rationale repeats that West may launch, so this is not merely a missing structured blocker.",
      "source_fact_codes": ["POL-GATES", "REL-WEST"]
    },
    {
      "finding_id": "F-03",
      "position": 6,
      "classification": "unsupported_regulatory_characterization",
      "observation": "The launch rationale says North satisfies all regulatory requirements. The dossier establishes the four gates of a rollout policy, not a body of regulatory requirements; the stronger characterization is unsupported and unnecessarily overstates the evidence.",
      "source_fact_codes": ["POL-GATES", "POL-REGION", "POL-PHASE"]
    },
    {
      "finding_id": "F-04",
      "position": 7,
      "classification": "german_language_requirement_not_met",
      "observation": "Although the executive summary is German, blocker explanations, evidence descriptions, action rationales and uncertainty reasons are predominantly English. The task explicitly requires all free-text values to be German.",
      "source_fact_codes": []
    },
    {
      "finding_id": "F-05",
      "position": 10,
      "classification": "contradictory_west_approval_and_unsupported_exception",
      "observation": "The executive prose first says North and West pass all gates and immediately says West fails the 95% completion gate. It also proposes an exception path that is not established by the dossier. These statements reduce both consistency and decision safety.",
      "source_fact_codes": ["POL-GATES", "POL-PHASE", "REL-WEST"]
    },
    {
      "finding_id": "F-06",
      "position": 15,
      "classification": "dashboard_recommendation_conflicts_with_phased_policy",
      "observation": "The dashboard-action rationale proposes that any failed regional gate should set the portfolio status to HOLD. The policy instead permits phased_go when at least one region passes and limits launch eligibility to passing regions. The proposed binary portfolio rule would therefore obscure the authorized North-only phase.",
      "source_fact_codes": ["POL-REGION", "POL-PHASE", "DASH-STATUS"]
    }
  ],
