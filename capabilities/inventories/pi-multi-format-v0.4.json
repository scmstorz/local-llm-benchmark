  "task_subset_size": 1,
  "model_visible_tools": [
    {"name": "list_artifacts", "implementation": "shared_python_backend", "side_effect": false},
    {"name": "read_docx", "implementation": "shared_python_backend", "side_effect": false},
    {"name": "read_pdf", "implementation": "shared_python_backend", "side_effect": false},
    {"name": "read_xlsx", "implementation": "shared_python_backend", "side_effect": false},
    {"name": "finish_report", "implementation": "schema_constrained_private_capture", "side_effect": false}
  ],
  "final_output": {
