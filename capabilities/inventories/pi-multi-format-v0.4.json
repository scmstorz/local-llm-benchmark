    "python_process": "direct exact Python.app worker",
    "pre_inference_extension_load": true
  },
  "unavailable_capabilities": [
    "filesystem_write",
    "shell",
    "arbitrary_code_execution",
    "browser",
    "external_network",
    "hidden_verifier",
    "persistent_memory",
    "subagents",
    "approvals",
    "unrelated_path_access"
  ],
  "context_policy": {
    "initial_artifact_contents": false,
    "query_catalog_visible_after_tool_call": true,
    "automatic_compaction": false
  }
