{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini multi-format transfer action v0.2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {"action": {"const": "list_artifacts"}}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "anchor"],
      "properties": {
        "action": {"const": "read_docx"},
        "anchor": {
          "enum": [
            "table=Eligibility-gates",
            "heading=Selection-sequence",
            "heading=Evidence-authority",
            "heading=Decision-cutoff"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "page", "element"],
      "properties": {
        "action": {"const": "read_pdf"},
        "page": {"enum": [2, 3]},
        "element": {
          "enum": [
            "table=Unsigned-draft",
            "note=Signed-final",
            "table=Final-assurance&row=Atlas",
            "table=Final-assurance&row=Boreal",
            "table=Final-assurance&row=Cedar",
            "table=Final-assurance&row=Delta"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sheet", "range"],
      "properties": {
        "action": {"const": "read_xlsx"},
        "sheet": {"enum": ["Bid Analysis", "Dashboard"]},
        "range": {
          "enum": ["B5:J5", "B6:J6", "B7:J7", "B8:J8", "B3:B5", "B7:B8"]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "report"],
      "properties": {
        "action": {"const": "finish_report"},
        "report": {"$ref": "#/$defs/decision_report"}
      }
    }
  ],
  "$defs": {
    "decision_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "executive_summary",
        "decision",
        "evidence",
        "conflicts",
        "recommended_actions",
        "uncertainties"
      ],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "executive_summary": {"type": "string", "minLength": 1},
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "primary_supplier", "reserve_supplier", "rejected_suppliers"],
          "properties": {
            "code": {"type": "string"},
            "primary_supplier": {"type": "string"},
            "reserve_supplier": {"type": "string"},
            "rejected_suppliers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["supplier", "blocker_code", "explanation"],
                "properties": {
                  "supplier": {"type": "string"},
                  "blocker_code": {"type": "string"},
                  "explanation": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_code", "source_ref", "supports"],
            "properties": {
              "fact_code": {"type": "string"},
              "source_ref": {"type": "string"},
              "supports": {"type": "string", "minLength": 1}
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "source_refs", "resolution"],
            "properties": {
              "code": {"type": "string"},
              "source_refs": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "resolution": {"type": "string", "minLength": 1}
            }
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "rationale"],
            "properties": {
              "code": {"type": "string"},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "reason"],
            "properties": {
              "code": {"type": "string"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
