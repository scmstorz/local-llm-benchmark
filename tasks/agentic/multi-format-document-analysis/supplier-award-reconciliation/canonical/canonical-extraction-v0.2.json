    {
      "fact_code": "POL-SELECTION",
      "source_ref": "supplier-selection-policy.docx#heading=Selection-sequence",
      "artifact_format": "docx",
      "record_type": "paragraph",
      "authority": "governing_policy",
      "text": "First exclude every ineligible supplier. Then select the eligible supplier with the lowest adjusted first-year cost as primary and the next-lowest eligible supplier as reserve. If only one supplier is eligible, make a single award; if none is eligible, make no award.",
      "fields": []
    },
    {
      "fact_code": "POL-AUTHORITY",
      "source_ref": "supplier-selection-policy.docx#heading=Evidence-authority",
      "artifact_format": "docx",
      "record_type": "paragraph",
      "authority": "governing_policy",
      "text": "The signed-final assurance appendix at the cutoff supersedes drafts. A commercial dashboard is contextual and cannot waive an assurance or capacity gate, even when it recommends the lowest-cost supplier.",
      "fields": []
    },
    {
