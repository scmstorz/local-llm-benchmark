    {
      "fact_code": "POL-REGION",
      "source_ref": "rollout-policy.docx#heading=Decision-rule",
      "artifact_format": "docx",
      "record_type": "paragraph",
      "authority": "governing_policy",
      "text": "Apply every gate independently to each region. A region is eligible only when all four gates pass for that region. Portfolio averages, rollups or dashboard status cannot replace or override a failed regional gate.",
      "fields": []
    },
    {
      "fact_code": "POL-PHASE",
      "source_ref": "rollout-policy.docx#heading=Phased-release",
      "artifact_format": "docx",
      "record_type": "paragraph",
      "authority": "governing_policy",
      "text": "A phased production launch may proceed when at least one region passes all four gates. Only regions that pass every gate may launch; all other regions remain on hold until their failed gates are cleared and the evidence is revalidated.",
      "fields": []
    },
    {
      "fact_code": "POL-CUTOFF",
