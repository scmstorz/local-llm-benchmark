{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-format decision report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executive_summary",
    "decision",
    "evidence",
    "conflicts",
    "recommended_actions",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "executive_summary": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "approved_regions", "blocked_regions"],
      "properties": {
        "code": {"type": "string"},
        "approved_regions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "blocked_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "blocker_code", "explanation"],
            "properties": {
              "region": {"type": "string"},
              "blocker_code": {"type": "string"},
              "explanation": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_code", "source_ref", "supports"],
        "properties": {
          "fact_code": {"type": "string"},
          "source_ref": {"type": "string"},
          "supports": {"type": "string", "minLength": 1}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "source_refs", "resolution"],
        "properties": {
          "code": {"type": "string"},
          "source_refs": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "rationale"],
        "properties": {
          "code": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "reason"],
        "properties": {
          "code": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
