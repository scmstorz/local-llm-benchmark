  ],
  "harness_families": [
    {
      "harness_id": "mini-v0.1",
      "config_path": "tasks/coding/track-b/mini-v0.1.json"
    },
    {
      "harness_id": "pi-v0.1",
      "config_path": "tasks/coding/track-b/pi-v0.1.json"
    }
  ],
  "experimental_unit": [
    "task",
    "model",
    "quantization",
    "runtime",
    "harness",
    "context_configuration",
    "reasoning_configuration",
    "tool_configuration",
    "run"
  ],
  "shared_permissions": {
    "read_scope": "candidate_visible_fixture_files_only",
    "write_scope": "artifact_contract_allowed_existing_files_only",
    "public_test_feedback": true,
    "hidden_test_feedback": false,
    "browser": false,
    "external_network": false,
    "arbitrary_shell": false
  },
  "network_boundary": {
    "ollama": "http_loopback_origin_only",
    "external_network": false
  },
  "budgets": {
    "maximum_agent_turns": 12,
    "maximum_protocol_errors": 3,
    "maximum_file_reads": 24,
    "maximum_file_writes": 8,
    "maximum_public_test_runs": 3,
    "maximum_total_output_tokens": 12000,
    "maximum_wall_time_seconds": 900
  },
  "time_budget_semantics": "Active harness execution time. Deliberate pauses between split mini-harness CLI steps are excluded; Pi runs in one continuous process.",
  "termination": {
    "successful_agent_termination_by_harness": {
      "mini-v0.1": "finish_action",
      "pi-v0.1": "normal_agent_end_event_and_zero_process_exit"
    },
    "terminal_failures": [
      "maximum_agent_turns_exceeded",
      "maximum_protocol_errors_exceeded",
      "maximum_total_output_tokens_exceeded",
      "maximum_wall_time_exceeded",
      "runtime_failure"
    ],
    "verification_after_every_termination": true,
    "verified_success_requires": [
      "harness_specific_valid_agent_termination",
      "workspace_scope_integrity",
      "public_tests_pass",
      "hidden_tests_pass"
    ]
  },
  "inference_defaults": {
    "temperature": 0.0,
    "seed": 42,
    "think": false,
    "num_ctx": 16384,
    "num_predict_per_turn": 1600,
    "keep_alive": "5m",
    "request_timeout_seconds": 300
  },
  "measurement": {
    "raw_trajectory_persisted": true,
    "tool_inputs_with_code_persisted_only_in_ignored_run_artifacts": true,
    "tracked_reports_are_sanitized": true,
    "required_trajectory_metrics": [
      "agent_turns",
      "tool_calls",
      "failed_tool_calls",
      "protocol_errors",
      "file_reads",
      "file_writes",
      "public_test_runs",
      "input_tokens",
      "output_tokens",
      "wall_time_seconds",
      "termination_reason",
      "time_to_first_successful_public_verification"
    ]
  },
  "comparison_rules": {
    "harness_results_reported_separately": true,
    "development_smokes_excluded": true,
    "initial_measured_runs_per_configuration": 1,
    "no_retries_or_adaptive_repetitions": true,
    "performance_and_reliability_repetitions_deferred": true
  },
  "freeze_requirements": [
    "mini-harness implementation and tests complete",
    "Pi package, CLI arguments and policy extension pinned",
    "both harnesses pass no-inference dry runs",
    "fixture, verifier, prompt and configuration hashes recorded",
    "execution order preregistered",
    "resource gate passes before inference"
  ]
}
