{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-llm-benchmark.invalid/schemas/source-grounded-writing-judge-result-v1.0.json",
  "title": "Interactive Codex source-grounded writing judge result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "case",
    "candidate_id",
    "judge",
    "deterministic_checks",
    "evidence_assessments",
    "personal_thought_assessments",
    "errors",
    "dimension_scores",
    "score_summary",
    "verdict",
    "overall_assessment",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_version", "card_version"],
      "properties": {
        "case_id": {
          "const": "source_grounded_writing.dev.agentic-software-development-reality-gap"
        },
        "case_version": {
          "const": "1.0.0"
        },
        "card_version": {
          "const": "1.0.0"
        }
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate-[a-z0-9-]+$"
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model_label", "evaluated_at", "instructions_version"],
      "properties": {
        "kind": {
          "const": "interactive_codex"
        },
        "model_label": {
          "type": ["string", "null"]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "instructions_version": {
          "const": "1.0.0"
        }
      }
    },
    "deterministic_checks": {
      "$ref": "#/$defs/deterministicChecks"
    },
    "evidence_assessments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/evidenceAssessment"
      }
    },
    "personal_thought_assessments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/personalThoughtAssessment"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "type", "description", "source_locations", "thought_ids"],
        "properties": {
          "known_error_id": {
            "type": ["string", "null"],
            "pattern": "^KE[0-9]{2}$"
          },
          "severity": {
            "enum": ["critical", "major", "minor"]
          },
          "type": {
            "enum": [
              "hallucination",
              "contradiction",
              "misattribution",
              "numeric_error",
              "causal_overclaim",
              "scope_inflation",
              "certainty_inflation",
              "unsupported_addition",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_locations": {
            "$ref": "#/$defs/sourceLocations"
          },
          "thought_ids": {
            "$ref": "#/$defs/thoughtIds"
          }
        }
      }
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factual_epistemic_accuracy",
        "cross_source_synthesis",
        "argument_reader_value",
        "linkedin_style",
        "compression_format"
      ],
      "properties": {
        "factual_epistemic_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "cross_source_synthesis": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "argument_reader_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "linkedin_style": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "compression_format": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_coverage",
        "personal_thought_integration",
        "raw_total",
        "caps_applied",
        "final_total"
      ],
      "properties": {
        "evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 25
        },
        "personal_thought_integration": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "raw_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "caps_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "verdict": {
      "enum": ["excellent", "good", "usable", "poor", "invalid"]
    },
    "overall_assessment": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    }
  },
  "$defs": {
    "sourceLocations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S(?:0[1-9]|1[0-9]|2[0-5])$"
      },
      "uniqueItems": true
    },
    "thoughtIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T0[1-3]$"
      },
      "uniqueItems": true
    },
    "coverageStatus": {
      "enum": ["full", "partial", "missing", "contradicted"]
    },
    "evidenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rationale", "source_locations"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E(?:0[1-9]|10)$"
        },
        "status": {
          "$ref": "#/$defs/coverageStatus"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_locations": {
          "$ref": "#/$defs/sourceLocations"
        }
      }
    },
    "personalThoughtAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "rationale"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T0[1-3]$"
        },
        "status": {
          "$ref": "#/$defs/coverageStatus"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deterministicChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_version",
        "nonempty",
        "detected_language",
        "language_method",
        "language_evidence",
        "language_pass",
        "word_count",
        "maximum_words",
        "maximum_words_pass",
        "source_location_labels_absent",
        "markdown_heading_count",
        "bold_heading_count",
        "structural_heading_count",
        "heading_pass",
        "reasoning_markup_absent",
        "generation_done_reason",
        "generation_complete"
      ],
      "properties": {
        "check_version": {
          "const": "1.0.0"
        },
        "nonempty": {
          "type": "boolean"
        },
        "detected_language": {
          "type": ["string", "null"]
        },
        "language_method": {
          "const": "stopword_heuristic_v1"
        },
        "language_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["german_stopword_hits", "english_stopword_hits"],
          "properties": {
            "german_stopword_hits": {
              "type": "integer",
              "minimum": 0
            },
            "english_stopword_hits": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "language_pass": {
          "type": "boolean"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_words": {
          "const": 600
        },
        "maximum_words_pass": {
          "type": "boolean"
        },
        "source_location_labels_absent": {
          "type": "boolean"
        },
        "markdown_heading_count": {
          "type": "integer",
          "minimum": 0
        },
        "bold_heading_count": {
          "type": "integer",
          "minimum": 0
        },
        "structural_heading_count": {
          "type": "integer",
          "minimum": 0
        },
        "heading_pass": {
          "type": "boolean"
        },
        "reasoning_markup_absent": {
          "type": "boolean"
        },
        "generation_done_reason": {
          "type": ["string", "null"]
        },
        "generation_complete": {
          "type": "boolean"
        }
      }
    }
  }
}
